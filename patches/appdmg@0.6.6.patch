@@ -63,6 +63,11 @@ exports.attach = function (path, cb) {
 exports.detach = function (path, cb) {
   const args = ['detach', path]
 
+  // macOS CI runners can automatically unmount a temporary image before the
+  // cleanup callback runs.  Treat an already absent mount point as detached.
+  const isDetached = () => !fs.existsSync(path)
+  if (isDetached()) return process.nextTick(cb)
+
   let attempts = 0
   function attemptDetach (err) {
     attempts += 1
@@ -70,6 +75,8 @@ exports.detach = function (path, cb) {
       setTimeout(function () {
         util.sh('hdiutil', args, attemptDetach)
       }, 1000 * Math.pow(2, attempts - 1))
+    } else if (err && isDetached()) {
+      cb(null)
     } else {
       cb(err)
     }
